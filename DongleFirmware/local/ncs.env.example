# Machine-specific NCS toolchain paths.
# Copy this file to ncs.env and fill in your values.
#
# Find your toolchain hash:
#   cat /opt/nordic/ncs/toolchains/toolchains.json
#
# macOS default install root: /opt/nordic/ncs/
# The toolchain hash changes per SDK version installed.

NCS_TOOLCHAIN="/opt/nordic/ncs/toolchains/<hash>"
NCS_SDK="/opt/nordic/ncs/<version>"
