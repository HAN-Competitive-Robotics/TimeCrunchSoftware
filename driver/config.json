      "keyboard": {
        "positive": "w",
        "negative": "s",
        "rate": 8
      },
      "expo": 0.0
    },
    "motor_right": {
      "type": "axis",
      "gamepad": {
        "axis": 4,
        "invert": true,
        "deadzone": 0.15
      },
      "keyboard": {
        "positive": "up",
        "negative": "down",
        "rate": 8
      },
      "expo": 0.0
    },
    "weapon": {
      "type": "button",
      "gamepad": {
        "button": 5
      },
      "keyboard": "space",
      "off_value": 0,
      "on_value": 255
    },
    "weapon_rev": {
      "type": "button",
      "gamepad": {
        "axis": 5,
        "threshold": 0.5
      },
      "keyboard": "lshift",
      "off_value": 0,
      "on_value": 255
    },
    "failsafe": {
      "type": "button",
      "gamepad": {
        "button": 1
      },
      "keyboard": "f",
      "off_value": 0,
      "on_value": 255
    }
  },
  "ui": {
    "width": 800,
    "height": 480,
    "theme": {
      "bg": [30, 30, 35],
      "panel": [45, 45, 55],
      "text": [220, 220, 220],
      "accent": [0, 200, 255],
      "warning": [255, 180, 0],
      "danger": [255, 60, 60],
      "good": [60, 255, 120]
    }
  }
}
